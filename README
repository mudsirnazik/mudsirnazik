<script>
  (function() {
    const canvas = document.getElementById('bg-canvas');
    const ctx = canvas.getContext('2d');
    let w, h;
    let particles = [];
    const PARTICLE_COUNT = 75;
    // moving icons + geometric shapes
    const ICONS = ['⬡', '⬢', '◆', '◇', '●', '○', '◈', '◉', '✧', '✦', '⬟', '⬠', '◍', '◎', '◌', '◔', '◕', '⬡', '⬢', '◆'];

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);

    class Particle {
      constructor() {
        this.reset();
      }
      reset() {
        this.x = Math.random() * w;
        this.y = Math.random() * h;
        this.size = 18 + Math.random() * 28;
        this.speedX = (Math.random() - 0.5) * 0.9;
        this.speedY = (Math.random() - 0.5) * 0.9;
        this.opacity = 0.2 + Math.random() * 0.5;
        this.icon = ICONS[Math.floor(Math.random() * ICONS.length)];
        this.rotation = Math.random() * 6.28;
        this.rotSpeed = (Math.random() - 0.5) * 0.025;
        this.driftX = (Math.random() - 0.5) * 0.25;
        this.driftY = (Math.random() - 0.5) * 0.25;
        this.hue = 180 + Math.random() * 40; // cyan/teal range
      }
      update() {
        this.x += this.speedX + this.driftX * 0.1;
        this.y += this.speedY + this.driftY * 0.1;
        this.rotation += this.rotSpeed;
        if (this.x < -50) this.x = w + 50;
        if (this.x > w + 50) this.x = -50;
        if (this.y < -50) this.y = h + 50;
        if (this.y > h + 50) this.y = -50;
        if (Math.random() < 0.004) {
          this.driftX = (Math.random() - 0.5) * 0.3;
          this.driftY = (Math.random() - 0.5) * 0.3;
        }
      }
      draw(ctx) {
        ctx.save();
        ctx.globalAlpha = this.opacity;
        ctx.font = `${this.size}px "Segoe UI", "Apple Color Emoji", "Noto Color Emoji", sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.translate(this.x, this.y);
        ctx.rotate(this.rotation);
        ctx.shadowColor = `hsl(${this.hue}, 70%, 60%, 0.25)`;
        ctx.shadowBlur = 22;
        ctx.fillStyle = `hsl(${this.hue}, 65%, 75%)`;
        ctx.fillText(this.icon, 0, 0);
        ctx.restore();
      }
    }

    function initParticles() {
      particles = [];
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        particles.push(new Particle());
      }
    }

    function animate() {
      ctx.clearRect(0, 0, w, h);
      // radial vignette
      const grad = ctx.createRadialGradient(w*0.5, h*0.5, 20, w*0.5, h*0.5, Math.max(w,h)*0.7);
      grad.addColorStop(0, 'rgba(15, 23, 42, 0.0)');
      grad.addColorStop(1, 'rgba(2, 6, 23, 0.4)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, w, h);

      particles.forEach(p => {
        p.update();
        p.draw(ctx);
      });
      requestAnimationFrame(animate);
    }

    resize();
    initParticles();
    animate();

    window.addEventListener('resize', () => {
      resize();
      particles.forEach(p => {
        p.x = Math.min(w, Math.max(0, p.x));
        p.y = Math.min(h, Math.max(0, p.y));
      });
    });
  })();
</script>
</body>
